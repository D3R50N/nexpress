{
  "name": "@nxpress/core",
  "version": "1.1.2",
  "description": "Express.js framework with file-based routing and template components",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "schema.json"
  ],
  "bin": {
    "nxp": "./dist/bin/nxpress.js",
    "nxpress": "./dist/bin/nxpress.js"
  },
  "repository": {
    "url": "https://github.com/D3R50N/nxpress"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "pnpm build",
    "dev": "tsc --watch",
    "example:hbs": "tsx example/handlebars/server.ts",
    "example:hbs:dev": "nodemon --delay 1 --watch example/handlebars --ext ts,hbs,html,js --exec tsx example/handlebars/server.ts",
    "example:ejs": "tsx example/ejs/server.ts",
    "example:ejs:dev": "nodemon --delay 1 --watch example/ejs --ext ts,ejs,html,js --exec tsx example/ejs/server.ts",
    "test": "tsx test/router.test.ts && tsx test/integration.test.ts"
  },
  "keywords": [
    "express",
    "framework",
    "handlebars",
    "typescript",
    "ssr",
    "routing",
    "next",
    "template",
    "ejs",
    "templating"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@tailwindcss/cli": "^4.3.3",
    "chalk": "^6.0.0",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "eta": "^4.6.0",
    "express": "^5.2.1",
    "express-handlebars": "^9.0.1",
    "glob": "^13.0.6",
    "hbs": "^4.2.1",
    "jiti": "^2.7.0",
    "liquidjs": "^10.27.2",
    "nunjucks": "^3.2.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/hbs": "^4.0.5",
    "@types/node": "^26.1.2",
    "@types/nunjucks": "^3.2.6",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
