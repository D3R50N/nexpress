<div class="bg-slate-800/60 border border-slate-700/60 hover:border-sky-500/50 rounded-2xl p-6 flex flex-col justify-between transition group shadow-lg">
  <div>
    <span class="inline-block bg-sky-500/10 text-sky-400 text-xs font-semibold px-3 py-1 rounded-full mb-3 border border-sky-500/20">
      {{category}}
    </span>
    <h3 class="text-lg font-bold text-white group-hover:text-sky-300 transition mb-2">
      {{name}}
    </h3>
    <p class="text-slate-400 text-sm mb-4 leading-relaxed">
      {{description}}
    </p>
  </div>
  <div class="flex justify-between items-center pt-4 border-t border-slate-700/40">
    <span class="text-xl font-extrabold text-sky-400">
      {{price}} {{G.currency}}
    </span>
    <a href="/products/{{id}}" class="bg-sky-600 hover:bg-sky-500 text-white text-sm font-semibold px-4 py-2 rounded-xl transition shadow">
      Voir le produit
    </a>
  </div>
</div>
