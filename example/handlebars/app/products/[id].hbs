<div style="margin-bottom: 1.5rem;">
  <a href="/products" style="color: #38bdf8; text-decoration: none;">&larr; Retour aux produits</a>
</div>

{{#if product}}
  <div class="card" style="padding: 2.5rem;">
    <span class="badge">{{product.category}}</span>
    <h1 style="margin-top: 0.5rem; font-size: 2rem;">{{product.name}}</h1>
    <p style="color: #94a3b8; font-size: 1.1rem; margin: 1rem 0;">{{product.description}}</p>
    
    <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 1.5rem; border-top: 1px solid #334155; padding-top: 1.5rem;">
      <span style="font-size: 2rem; font-weight: bold; color: #38bdf8;">{{product.price}} {{G.currency}}</span>
      <button class="btn" onclick="alert('Produit ajouté !')">Commander Maintenant</button>
    </div>
  </div>
{{else}}
  <div class="card">
    <h2>⚠️ Produit non trouvé</h2>
    <p>Le produit avec l'identifiant <code>{{C.params.id}}</code> n'existe pas.</p>
  </div>
{{/if}}
