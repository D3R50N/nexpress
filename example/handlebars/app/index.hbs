<div style="text-align: center; margin-bottom: 3rem;">
  <h1 style="font-size: 2.5rem; margin-bottom: 1rem;">🚀 {{upper G.siteName}}</h1>
  <p style="color: #94a3b8; font-size: 1.1rem;">
    Framework SSR Express avec routage par fichiers et typage TypeScript.
  </p>
</div>

<div class="card" style="margin-bottom: 2rem; border: 1px solid #38bdf8;">
  <h2>🎭 Blague du Jour (SSR API)</h2>
  {{#if joke}}
    {{#if (eq joke.type "single")}}
      <p style="font-size: 1.1rem; margin-top: 1rem;">{{joke.joke}}</p>
    {{else}}
      <p style="font-size: 1.1rem; font-weight: bold; margin-top: 1rem;">👉 {{joke.setup}}</p>
      <p style="font-size: 1.1rem; color: #38bdf8; margin-top: 0.5rem;">💡 {{joke.delivery}}</p>
    {{/if}}
  {{else}}
    <p style="color: #94a3b8;">Chargement de la blague impossible.</p>
  {{/if}}
</div>

<div class="card" style="margin-bottom: 2rem;">
  <h2>📌 Démonstration des Helpers</h2>
  <ul style="margin-top: 1rem; padding-left: 1.5rem; line-height: 1.8;">
    <li><strong>Majuscule (upper) :</strong> {{upper G.siteName}}</li>
    <li><strong>Minuscule (lower) :</strong> {{lower G.siteName}}</li>
    <li><strong>Nombre de produits (len) :</strong> {{len featuredProducts}}</li>
    <li><strong>Capitalize :</strong> {{capitalize 'bonjour tout le monde'}}</li>
    <li><strong>JSON Stringify (str) :</strong> <code>{{{str G}}}</code></li>
  </ul>
</div>

<h2>🔥 Produits en Vedette</h2>
<div class="grid">
  {{#each featuredProducts}}
    {{> ProductCard id=this.id name=this.name description=this.description price=this.price category=this.category }}
  {{/each}}
</div>
