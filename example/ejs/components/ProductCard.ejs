<div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700/60 rounded-xl p-5 shadow-sm hover:shadow-md transition-all flex flex-col justify-between">
  <div>
    <span class="inline-block text-xs font-semibold px-2.5 py-1 rounded-full bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 mb-3"><%= product.category %></span>
    <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2"><%= product.name %></h3>
    <p class="text-slate-600 dark:text-slate-400 text-sm mb-4"><%= product.description %></p>
  </div>
  <div>
    <div class="text-xl font-extrabold text-sky-500 mb-4"><%= product.price %> <%= G.currency %></div>
    <a href="/products/<%= product.id %>" class="inline-flex items-center justify-center w-full px-4 py-2 text-sm font-semibold rounded-lg bg-sky-500 text-white hover:bg-sky-600 transition-colors">Voir détails &rarr;</a>
  </div>
</div>
