<div class="text-center mb-8">
  <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white mb-2">🚀 <%= upper(G.siteName) %></h1>
  <p class="text-slate-600 dark:text-slate-400">Application de démonstration Nxpress utilisant le moteur de rendu EJS.</p>
</div>

<div class="bg-white dark:bg-slate-800 border border-sky-500/30 rounded-xl p-6 mb-8 shadow-sm cursor-pointer hover:border-sky-500 transition-colors" onclick="__nxpress__.theme.toggle()">
  <div class="flex items-center justify-between mb-3">
    <h2 class="text-xl font-bold text-slate-900 dark:text-white">🎭 Blague du Jour (SSR API)</h2>
    <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-sky-500/10 text-sky-500 border border-sky-500/20">Cliquer pour basculer de thème 🌓</span>
  </div>
  <% if (joke) { %>
    <% if (joke.type === 'single') { %>
      <p class="text-base text-slate-700 dark:text-slate-300 mt-2"><%= joke.joke %></p>
    <% } else { %>
      <p class="text-base font-semibold text-slate-900 dark:text-slate-100 mt-2">👉 <%= joke.setup %></p>
      <p class="text-base text-sky-500 font-medium mt-2">💡 <%= joke.delivery %></p>
    <% } %>
  <% } else { %>
    <p class="text-slate-500 dark:text-slate-400">Chargement de la blague impossible.</p>
  <% } %>
</div>

<div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700/60 rounded-xl p-6 mb-8 shadow-sm">
  <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-4">📌 Démonstration des Helpers</h2>
  <ul class="space-y-2 text-slate-700 dark:text-slate-300">
    <li><strong class="text-slate-900 dark:text-white">Majuscule (upper) :</strong> <%= upper(G.siteName) %></li>
    <li><strong class="text-slate-900 dark:text-white">Minuscule (lower) :</strong> <%= lower(G.siteName) %></li>
    <li><strong class="text-slate-900 dark:text-white">Nombre de produits (len) :</strong> <%= len(products) %></li>
    <li><strong class="text-slate-900 dark:text-white">Capitalize :</strong> <%= capitalize('bienvenue') %></li>
    <li><strong class="text-slate-900 dark:text-white">JSON (str) :</strong> <code class="bg-slate-100 dark:bg-slate-900 px-2 py-0.5 rounded text-sky-500 text-sm font-mono"><%= str(G.siteName) %></code></li>
  </ul>
</div>

<h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-4">🔥 Produits Exemple</h2>
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
  <% products.forEach(product => { %>
    <%- $('ProductCard', { product }) %>
  <% }) %>
</div>
